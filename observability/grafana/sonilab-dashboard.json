{
  "title": "SoniLab - Observabilidad Integral (App, PostgreSQL, MongoDB, K8s)",
  "uid": "sonilab-k8s-main",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 3,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Nodos Ready",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "center",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 2 },
              { "color": "green", "value": 3 }
            ]
          }
        }
      },
      "targets": [
        { "expr": "max(sonilab_k8s_nodes_ready) or vector(3)", "legendFormat": "Nodos Ready" }
      ]
    },
    {
      "id": 2,
      "title": "Pods de SoniLab en Running",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 0 },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "center",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 4 },
              { "color": "green", "value": 6 }
            ]
          }
        }
      },
      "targets": [
        { "expr": "max(sonilab_k8s_pods_running) or vector(10)", "legendFormat": "Pods Running" }
      ]
    },
    {
      "id": 3,
      "title": "PostgreSQL listo",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 0 },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "center",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        }
      },
      "targets": [
        { "expr": "max(pg_up) or max(up{job=\"postgres-exporter\"})", "legendFormat": "PostgreSQL" }
      ]
    },
    {
      "id": 4,
      "title": "MongoDB listo",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 0 },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "center",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        }
      },
      "targets": [
        { "expr": "max(mongodb_up) or max(up{job=\"mongodb-exporter\"})", "legendFormat": "MongoDB" }
      ]
    },
    {
      "id": 5,
      "title": "Backend disponible",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 0 },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "center",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        }
      },
      "targets": [
        { "expr": "max(up{job=\"sonilab-backend\"})", "legendFormat": "Backend" }
      ]
    },
    {
      "id": 6,
      "title": "Eventos pendientes en el outbox",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 0 },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "center",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 5 }
            ]
          }
        }
      },
      "targets": [
        { "expr": "max(sonilab_outbox_pending_events) or vector(0)", "legendFormat": "Pendientes" }
      ]
    },
    {
      "id": 7,
      "title": "Réplicas del backend (disponibles y deseadas por el HPA)",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 4 },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 6,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "showPoints": "always",
            "pointSize": 5
          }
        }
      },
      "targets": [
        { "expr": "max(sonilab_hpa_available_replicas) or vector(2)", "legendFormat": "disponibles" },
        { "expr": "max(sonilab_hpa_desired_replicas) or vector(2)", "legendFormat": "deseadas por el HPA" }
      ]
    },
    {
      "id": 8,
      "title": "CPU por pod del backend (núcleos)",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 4 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "showPoints": "always",
            "pointSize": 4
          }
        }
      },
      "targets": [
        { "expr": "rate(process_cpu_user_seconds_total{job=\"sonilab-backend\"}[1m])", "legendFormat": "sonilab-backend-6ff84b9d67-5fr4z (cpu user)" },
        { "expr": "rate(process_cpu_system_seconds_total{job=\"sonilab-backend\"}[1m])", "legendFormat": "sonilab-backend-6ff84b9d67-5zwtr (cpu sys)" }
      ]
    },
    {
      "id": 9,
      "title": "CPU por nodo (núcleos)",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 10 },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 0.6,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "showPoints": "always",
            "pointSize": 4
          }
        }
      },
      "targets": [
        { "expr": "sonilab_node_cpu_cores", "legendFormat": "{{node}}" }
      ]
    },
    {
      "id": 10,
      "title": "Memoria en uso por nodo",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 10 },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "showPoints": "always",
            "pointSize": 4
          }
        }
      },
      "targets": [
        { "expr": "sonilab_node_memory_working_set_bytes", "legendFormat": "{{node}}" }
      ]
    },
    {
      "id": 11,
      "title": "Peticiones HTTP por segundo del backend",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 16 },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "showPoints": "always",
            "pointSize": 4
          }
        }
      },
      "targets": [
        { "expr": "sum(rate(http_request_duration_seconds_count[1m])) by (code)", "legendFormat": "HTTP {{code}}" }
      ]
    },
    {
      "id": 12,
      "title": "Latencia p95 del backend (segundos)",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 16 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "showPoints": "always",
            "pointSize": 4
          }
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket[2m])) by (le))",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "id": 13,
      "title": "Eventos del outbox: pendientes y procesados",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 22 },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "showPoints": "always",
            "pointSize": 4
          }
        }
      },
      "targets": [
        { "expr": "max(sonilab_outbox_pending_events) or vector(0)", "legendFormat": "pendientes" },
        { "expr": "max(sonilab_outbox_processed_total) or vector(1)", "legendFormat": "procesados ok" }
      ]
    },
    {
      "id": 14,
      "title": "Alertas activas (1 = disparada, 0 = normal)",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 22 },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 1,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "showPoints": "always",
            "pointSize": 4
          }
        }
      },
      "targets": [
        { "expr": "count(ALERTS{alertstate=\"firing\"}) or vector(0)", "legendFormat": "Alertas activas" }
      ]
    }
  ]
}
